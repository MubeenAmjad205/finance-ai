# ==========================================
# Personal Finance AI Bot Credentials
# ==========================================

# 1. Telegram Personal Finance Bot (Private DM Bot)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. Telegram Webhook Secret Token (Must contain ONLY letters, numbers, _, -)
TELEGRAM_SECRET_TOKEN="your_random_secure_secret_token_here"

# 3. Chat ID for scheduled morning digests & alerts
TELEGRAM_CHAT_ID="-100123456789"

# 4. Security Whitelist: Comma-separated Telegram User IDs allowed to interact with the bot
# To get your ID, message @userinfobot or @raw_data_bot on Telegram
TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"

# ==========================================
# MongoDB Connection (Native URI or Data API)
# ==========================================
# Native Connection String (mongodb:// or mongodb+srv://)
MONGODB_URI="mongodb://user:password@host1:27017,host2:27017/?ssl=true&replicaSet=atlas-xxx&authSource=admin"
MONGODB_DATABASE="finance_db"

# (Optional Fallback) Legacy Atlas Data API
# MONGODB_DATA_API_KEY="your_mongodb_atlas_data_api_key"
# MONGODB_APP_ID="data-app-id"
MONGODB_DATA_SOURCE="Cluster0"

# ==========================================
# Web Dashboard Authentication & Settings
# ==========================================
DASHBOARD_PASSCODE="admin123"
DEFAULT_CURRENCY="PKR"
