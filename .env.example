# ==========================================
# Personal Finance AI Bot & Office Group Bot Credentials
# ==========================================

# 1. Telegram Personal Finance Bot (Private DM Bot)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. Telegram Office Group Lunch Bot (Dedicated Group Bot)
# Get dedicated token from @BotFather, or leave blank to use TELEGRAM_BOT_TOKEN above
TELEGRAM_GROUP_BOT_TOKEN=""

# 3. Telegram Webhook Secret Token (Must contain ONLY letters, numbers, _, -)
TELEGRAM_SECRET_TOKEN="your_random_secure_secret_token_here"

# 4. Optional Chat ID for scheduled notifications
TELEGRAM_CHAT_ID=-100123456789

# ==========================================
# MongoDB Atlas Data API Credentials
# ==========================================
# Enable Data API in MongoDB Atlas App Services -> Data API
MONGODB_DATA_API_KEY="your_mongodb_atlas_data_api_key"
MONGODB_APP_ID="data-app-id"
MONGODB_DATABASE="finance_db"
MONGODB_DATA_SOURCE="main"

# ==========================================
# Web Dashboard Authentication & Settings
# ==========================================
DASHBOARD_PASSCODE="admin123"
DEFAULT_CURRENCY="PKR"
