{
  "name": "finance-ai",
  "version": "1.0.0",
  "description": "Minimal personal budgeting and finance management LLM powered Telegram bot & dashboard on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "build:frontend": "npm run --prefix frontend build",
    "build:all": "npm run --prefix frontend build && wrangler deploy --dry-run",
    "test": "npx tsx scripts/test-services.ts && npm run typecheck"
  },
  "keywords": [
    "cloudflare-workers",
    "telegram-bot",
    "finance",
    "budgeting",
    "workers-ai",
    "mongodb-atlas",
    "pakistan-payments",
    "jazzcash",
    "easypaisa"
  ],
  "author": "MubeenAmjad205",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.4.1",
    "@prisma/extension-accelerate": "^1.2.2",
    "dotenv": "^8.2.0",
    "fuse.js": "^7.0.0",
    "hono": "^4.6.12",
    "mongodb": "^6.14.2",
    "node-fetch": "^3.3.2",
    "prisma": "^6.4.1",
    "ws": "^8.21.3"
  }
}
